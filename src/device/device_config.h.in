#ifndef __DEVICE_DEVICE_CONFIG__
#define __DEVICE_DEVICE_CONFIG__

/**
 * Parameters and options for device backends
 */

/**
 * Floating point precision in device kernels
 * @note Set to the same C/C++ equivalent type as @a rp
 */
typedef @NEKO_DEV_REAL_TYPE@ real;
#ifdef __APPLE__
typedef real real_xp;
#else
typedef @NEKO_DEV_XREAL_TYPE@ real_xp;
#endif

/**
 * Floating point precision of the geometric factors in device kernels
 * @note Set to the same C/C++ equivalent type as @a gp. Kernels read the
 * factors through pointers of this type and convert to @a real on load,
 * since the two may differ in size.
 */
typedef @NEKO_DEV_GREAL_TYPE@ real_gp;
extern void *glb_ctx;
extern void *glb_cmd_queue;
extern void *glb_device_id;

#ifdef HAVE_OPENCL
/**
 * OpenCL queue with profiling enabled
 */
extern void* prf_cmd_queue;
#endif

#endif // __DEVICE_DEVICE_CONFIG__
